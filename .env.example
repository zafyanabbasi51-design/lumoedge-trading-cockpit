# =============================================================================
# LUMO EDGE FOREX BOT - ENVIRONMENT CONFIGURATION
# Powered by: Lumo Edge | Owner: Gontse
# =============================================================================

# Your MetaTrader 5 account login number (integer)
MT5_ACCOUNT=12345678

# Your MetaTrader 5 account trading password
MT5_PASSWORD=your_trading_password

# Your broker MT5 server name (e.g. Exness-MT5Trial16, MetaQuotes-Demo, etc.)
MT5_SERVER=YourBroker-Server

# Optional: Path to terminal64.exe if MT5 is installed in a custom location
MT5_PATH=

# SAFETY SWITCH:
# 0 = Paper Mode (Bot scans and logs trades, but sends NO real orders to broker)
# 1 = Live Trading (Bot sends real orders to your broker account)
LIVE_TRADING=0
